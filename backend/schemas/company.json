{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer", "minimum": 1, "maximum": 999 },
    "location": { "type": "string" },
    "notes": { "type": "string" }
  }
}
